# 本地开发,环境变量配置模板
# 复制此文件为 .env 并填入真实的配置值

# ===========================================
# 模型配置 (Model Configuration)
# ===========================================
MODEL_TEMPERATURE=0

# ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL_NAME=qwen3:8b
EMBEDDING_MODEL_NAME=bge-m3:latest

# OPENAI模型
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini
OPEN_AI_EMBEDDINGS=

# ===========================================
# 数据库配置 (Database Configuration)
# ===========================================
REDIS_URL=redis://localhost:6379/0
QDRANT_PATH=./qdrant
QDRANT_COLLECTION_NAME=knowledge_base
BASE_UPLOAD_DIR=./uploads

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mystical_oracle
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mystical_oracle

# ===========================================
# JWT 认证配置
# ===========================================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720


# ===========================================
# Agent 配置 (Agent Configuration)
# ===========================================
MAX_HISTORY_MESSAGES=10

# ===========================================
# LANGSMITH 监控配置
# ===========================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmithapi_key_here
LANGSMITH_PROJECT=mystical-oracle

# ===========================================
# API 密钥 (API Keys) - 必须配置
# ===========================================
# 搜索 API (用于实时信息获取)
SERPAPI_API_KEY=your_serpapi_key_here

# 缘分居 API (用于八字、解梦、占卜功能)
YUANFENJU_API_KEY=your_yuanfenju_key_here

# ===========================================
# TTS 配置 (Text-to-Speech Configuration)
# ===========================================
AUDIO_OUTPUT_DIR=./audio

# ===========================================
# 日志配置 (Logging Configuration)
# ===========================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# ===========================================
# 高级配置 (Advanced Configuration)
# ===========================================
# 用户代理
USER_AGENT='Mozilla/5.0 (Mystical Oracle/1.0)'

# 时区设置
TZ=Asia/Shanghai
